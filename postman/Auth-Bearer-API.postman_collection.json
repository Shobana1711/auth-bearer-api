              "body": "{\n  \"success\": true,\n  \"message\": \"Users retrieved\",\n  \"data\": [\n    {\n      \"id\": \"665f1c2e9b1d4a0012ab34cd\",\n      \"username\": \"john\",\n      \"email\": \"john@example.com\",\n      \"role\": \"user\"\n    }\n  ]\n}"
